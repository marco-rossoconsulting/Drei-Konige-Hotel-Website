---
interface Link { label: string; href: string; }
interface Column {
  heading: string;
  links?: Link[];
  lines?: string[];
}

interface Props {
  brandTagline: string;
  columns: Column[];
  copyright: string;
  legalLinks: Link[];
  /* On sub-pages: prefix for #anchor links, e.g. '/en/' → '/en/#rooms' */
  anchorBase?: string;
  /* Page locale, for the "Cookie settings" label */
  locale?: 'de' | 'en' | 'fr' | 'it';
}

const { brandTagline, columns, copyright, legalLinks, anchorBase = '', locale = 'de' } = Astro.props;
const cookieSettingsLabel = { de: 'Cookie-Einstellungen', en: 'Cookie settings', fr: 'Paramètres des cookies', it: 'Impostazioni cookie' }[locale];
const fixHref = (href: string) => (anchorBase && href.startsWith('#') && href.length > 1 ? `${anchorBase}${href}` : href);
---

<footer>
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <p>{brandTagline}</p>
      </div>
      {columns.map((col) => (
        <div class="footer-col">
          <h4>{col.heading}</h4>
          {col.links && col.links.length > 0 && (
            <ul>
              {col.links.map((link) => (
                <li><a href={fixHref(link.href)}>{link.label}</a></li>
              ))}
            </ul>
          )}
          {col.lines && col.lines.map((line, i) => (
            <p style={i === 0 ? '' : 'margin-top: 16px;'} set:html={line.replace(/\n/g, '<br/>')}></p>
          ))}
        </div>
      ))}
    </div>
    <div class="footer-bottom">
      <span>{copyright}</span>
      <div class="footer-bottom-right">
        {legalLinks.map((link) => (
          <a href={fixHref(link.href)}>{link.label}</a>
        ))}
        <button type="button" class="footer-cookie-btn" data-consent-open aria-controls="dk-consent">{cookieSettingsLabel}</button>
      </div>
    </div>
  </div>
</footer>
