---
/**
 * AstiaCredit.astro: the "Website by astia·web" footer credit.
 *
 * <AstiaCredit site="hotel-bellavista" />                              light footer, English
 * <AstiaCredit site="hotel-bellavista" lang="de" tone="paper" />       dark footer, German
 * <AstiaCredit site="hotel-bellavista" tone="auto" background="#1f3d2e" />   picks Ink or Paper by contrast
 *
 * Needs no fonts and no JS. The wordmark is drawn as vector outlines of Instrument Serif Italic (OFL).
 * Brand rules baked in: Ink letters on light, Paper letters on dark, Signal Red dot always,
 * minimum 18px, clear space equal to the height of the "a", no recolouring on hover.
 */
interface Props {
  /** Short client name for analytics, e.g. "hotel-bellavista". Becomes utm_source. */
  site: string;
  /** Label language. */
  lang?: 'en' | 'de' | 'it' | 'fr';
  /** 'ink' for light footers, 'paper' for dark footers, 'auto' to choose from `background`. */
  tone?: 'ink' | 'paper' | 'auto';
  /** Footer background as #rrggbb. Required when tone="auto". */
  background?: string;
  /** Wordmark type size in px. Clamped to a minimum of 18. */
  size?: number;
  /** Set true only if you deliberately want the link to pass ranking signals. Default is nofollow. */
  follow?: boolean;
  /** Open astiaweb.com in a new tab. Guide default is false (visitors keep their tab). */
  newTab?: boolean;
  class?: string;
}

const { site, lang = 'en', tone = 'ink', background, size = 22, follow = false, newTab = false, class: className } = Astro.props;

const LABELS = { en: 'Website by', de: 'Website von', it: 'Sito web di', fr: 'Site web par' } as const;

const lum = (hex: string) => {
  const c = hex.replace('#', '').match(/.{2}/g)!.map((h) => parseInt(h, 16) / 255)
    .map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
  return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
};
const contrast = (a: string, b: string) => {
  const [hi, lo] = [lum(a), lum(b)].sort((x, y) => y - x);
  return (hi + 0.05) / (lo + 0.05);
};

let resolved: 'ink' | 'paper' = tone === 'paper' ? 'paper' : 'ink';
if (tone === 'auto') {
  if (!background) throw new Error('AstiaCredit: tone="auto" needs a background="#rrggbb".');
  const ink = contrast('#141414', background);
  const paper = contrast('#F7F5F0', background);
  resolved = ink >= paper ? 'ink' : 'paper';
  if (Math.max(ink, paper) < 4.5) {
    console.warn(`AstiaCredit: ${background} gives only ${Math.max(ink, paper).toFixed(1)}:1 for the wordmark. Put the credit on a Paper or Ink bottom bar instead.`);
  }
}

const href = `https://astiaweb.com/?utm_source=${encodeURIComponent(site)}&utm_medium=footer-credit&utm_campaign=client-footer`;
const rel = follow ? 'noopener' : 'nofollow noopener';
// Accessible name: visible label + brand name, so it matches what sighted users read (WCAG 2.5.3).
const ariaLabel = `${LABELS[lang]} Astia Web`;
---

<a class:list={['astia-credit', className]} data-tone={resolved === 'paper' ? 'paper' : undefined} href={href} rel={rel} target={newTab ? '_blank' : undefined} aria-label={ariaLabel} style={`--astia-size:${size}px`}>
  <span class="astia-credit__label">{LABELS[lang]}</span>
