---
/* Impressum page (one per locale). Same layout as the Privacy page
 * (LegalPage.astro). Text lives in src/content/legal/{locale}/imprint.json
 * (editable in the CMS under "Legal → Impressum"). */
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { imprintPaths, homePaths, hreflangs, type Locale } from '../lib/legal';

interface Props { locale: Locale; }
const { locale } = Astro.props;

const htmlLang: Record<Locale, string> = { en: 'en', de: 'de-CH', fr: 'fr-CH', it: 'it-CH' };

const allSingletons = import.meta.glob(
  '../content/{settings,legal}/*/*.json',
  { eager: true }
) as Record<string, { default: any }>;

function get(group: 'settings' | 'legal', name: string): any {
  const key = Object.keys(allSingletons).find((k) => k.endsWith(`/${group}/${locale}/${name}.json`));
  if (!key) throw new Error(`Missing singleton: ${group}/${locale}/${name}`);
  return allSingletons[key].default;
}

const site = get('settings', 'site');
const nav = get('settings', 'nav');
const footer = get('settings', 'footer');
const page = get('legal', 'imprint');

const home = homePaths[locale];
const langHrefs = { ...imprintPaths };

const alternates = [
  ...(Object.keys(imprintPaths) as Locale[]).map((l) => ({
    hreflang: hreflangs[l],
    href: new URL(imprintPaths[l], Astro.site).toString()
  })),
  { hreflang: 'x-default', href: new URL(imprintPaths.de, Astro.site).toString() }
];

const hotelName = 'Hotel Drei Könige';
---

<Layout
  title={`${page.title} · ${hotelName}`}
  description={page.description}
  ogImage={site.ogImage}
  ogImageAlt={site.ogImageAlt}
  favicon={site.favicon}
  htmlLang={htmlLang[locale]}
  locale={locale}
  alternates={alternates}
>
  <Nav
    logoImage={nav.logoImage}
    menu={nav.menu}
    reserveCta={nav.reserveCta}
    locale={locale}
    anchorBase={home}
    langHrefs={langHrefs}
  />

  <article class="legal-page">
    <div class="container-narrow">
      <header class="legal-header">
        <h1 class="display">{page.heading}</h1>
      </header>

      <section class="legal-body" set:html={page.bodyHtml} />
    </div>
  </article>

  <Footer
    brandTagline={footer.brandTagline}
    columns={footer.columns}
    copyright={footer.copyright}
    legalLinks={footer.legalLinks}
    locale={locale}
    anchorBase={home}
  />
</Layout>
