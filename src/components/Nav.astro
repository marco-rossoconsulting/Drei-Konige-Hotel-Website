---
interface MenuItem { label: string; href: string; }
interface Cta { label: string; href: string; }

interface Props {
  logoImage: string;
  menu: MenuItem[];
  reserveCta: Cta;
  locale: 'en' | 'de' | 'fr' | 'it';
}

const { logoImage, menu, reserveCta, locale } = Astro.props;

// All 4 locales — Reichsgasse 18 stays the same; ID anchors stay the same; only URL prefix changes.
const langs: Array<{ code: 'en' | 'de' | 'fr' | 'it'; label: string; href: string }> = [
  { code: 'de', label: 'DE', href: '/'    },
  { code: 'en', label: 'EN', href: '/en/' },
  { code: 'fr', label: 'FR', href: '/fr/' },
  { code: 'it', label: 'IT', href: '/it/' }
];
---

<nav class="nav" id="nav">
  <div class="container nav-inner">
    <a href={locale === 'de' ? '/' : `/${locale}/`} class="nav-logo">
      {logoImage ? (
        <img src={logoImage} alt="Hotel Drei Könige" class="nav-logo-img" />
      ) : (
        <>
          <span class="nav-logo-mark">Drei<em>Könige</em></span>
          <span class="nav-logo-sub">Anno 1793</span>
        </>
      )}
    </a>

    {/* Desktop menu */}
    <ul class="nav-menu">
      {menu.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>

    <div class="nav-right">
      <div class="lang-switch">
        {langs.map((lang, i) => (
          <>
            <a
              href={lang.href}
              class={lang.code === locale ? 'active' : ''}
              aria-label={`Switch to ${lang.label}`}
            >{lang.label}</a>
            {i < langs.length - 1 && <span class="divider">/</span>}
          </>
        ))}
      </div>
      <a href={reserveCta.href} class="btn nav-book-btn" target="_blank" rel="noopener">{reserveCta.label}</a>

      {/* Mobile hamburger */}
      <button
        type="button"
        class="nav-hamburger"
        id="nav-toggle"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="nav-mobile"
      >
        <span class="hamburger-line" aria-hidden="true"></span>
        <span class="hamburger-line" aria-hidden="true"></span>
        <span class="hamburger-line" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  {/* Mobile menu panel */}
  <div class="nav-mobile" id="nav-mobile" aria-hidden="true">
    <div class="nav-mobile-inner">
      <ul class="nav-mobile-menu">
        {menu.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
      <div class="nav-mobile-footer">
        <div class="lang-switch">
          {langs.map((lang, i) => (
            <>
              <a
                href={lang.href}
                class={lang.code === locale ? 'active' : ''}
                aria-label={`Switch to ${lang.label}`}
              >{lang.label}</a>
              {i < langs.length - 1 && <span class="divider">/</span>}
            </>
          ))}
        </div>
        <a href={reserveCta.href} class="btn nav-book-btn" target="_blank" rel="noopener">{reserveCta.label}</a>
      </div>
    </div>
  </div>
</nav>

<!--
  Inline (not bundled) so the toggle works the moment the nav is parsed, incl. iOS Safari.
  Uses one delegated click handler that re-queries the elements on every tap, so it
  cannot be left holding stale references. Buttons fire `click` reliably on iOS;
  `touch-action: manipulation` on the button removes the tap delay. We deliberately
  do not also listen to pointerup/touchend — that would toggle twice per tap.
-->
<script is:inline>
  (function () {
    if (window.__dkNavInit) return;
    window.__dkNavInit = true;

    function getToggle() { return document.getElementById('nav-toggle'); }
    function getMobile() { return document.getElementById('nav-mobile'); }

    function isOpen() {
      var toggle = getToggle();
      return !!toggle && toggle.getAttribute('aria-expanded') === 'true';
    }

    function setOpen(open) {
      var toggle = getToggle();
      var mobile = getMobile();
      if (!toggle || !mobile) return;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      mobile.setAttribute('aria-hidden', open ? 'false' : 'true');
      document.documentElement.classList.toggle('nav-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    }

    document.addEventListener('click', function (e) {
      var target = e.target;
      if (!target || typeof target.closest !== 'function') return;

      if (target.closest('#nav-toggle')) {
        e.preventDefault();
        setOpen(!isOpen());
        return;
      }

      // Close when a link inside the overlay is tapped (anchors, language, Book Now)
      if (isOpen() && target.closest('#nav-mobile a')) {
        setOpen(false);
      }
    });

    // Close on Escape
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && isOpen()) setOpen(false);
    });

    // Close if the viewport grows past the mobile breakpoint (rotation / resize)
    window.addEventListener('resize', function () {
      if (isOpen() && window.innerWidth > 1024) setOpen(false);
    });
  })();
</script>
