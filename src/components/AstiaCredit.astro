<style is:global>
.astia-credit {
  --astia-size: 22px;                 /* wordmark type size. Never below 18px (the dot becomes a comma) */
  --astia-letters: #141414;           /* Ink. Switch to Paper with data-tone="paper" on dark footers */
  --_s: max(18px, var(--astia-size));
  --_x: calc(var(--_s) * 0.516);      /* clear space = height of the lowercase "a" */
  display: inline-flex;
  align-items: baseline;
  gap: var(--_x);
  padding: var(--_x);
  font-family: inherit;               /* the label follows the client's own footer font */
  font-size: 0.8125rem;
  line-height: 1;
  color: inherit;
  text-decoration: none;
  white-space: nowrap;
}
.astia-credit[data-tone="paper"] { --astia-letters: #F7F5F0; }  /* Paper letters on Ink */
.astia-credit__mark {
  display: block;
  flex: none;
  height: calc(var(--_s) * 0.753);
  width: calc(var(--_s) * 3.275);
  margin-bottom: calc(var(--_s) * -0.010);   /* sit the baseline on the label's baseline */
}
.astia-credit__letters { fill: var(--astia-letters); }
.astia-credit__dot { fill: #E62127; }          /* Signal Red: the dot, only. Never overridden */
.astia-credit:hover .astia-credit__label,
.astia-credit:focus-visible .astia-credit__label { text-decoration: underline; text-underline-offset: 0.2em; }
.astia-credit:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; border-radius: 2px; }
@media print { .astia-credit { color: #141414; } }
</style>
